# Optional: where the Vite dev-server proxy should forward /api requests.
# Defaults to http://localhost:8000 if unset.
VITE_API_PROXY_TARGET=http://localhost:8000

# Optional: continuous-monitoring heartbeat/camera-sample interval, in
# milliseconds. Defaults to 8000 (8s) if unset.
VITE_MONITORING_INTERVAL_MS=2500

# Optional: grace window (ms) given to the camera stream / face-api models
# to (re)initialize after a monitoring session (re)starts — e.g. right
# after an admin-approved reauthentication — before a not-yet-ready camera
# is treated as a failed identity check. Defaults to 8000 (8s) if unset.
VITE_MONITORING_CAMERA_GRACE_MS=8000
