# --- MongoDB ---------------------------------------------------------
# Development default (no auth, no TLS) — fine for local `docker run
# mongo:7` or a local mongod. See docs/SECURITY_MONGODB.md before
# using anything else in production.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cipherq_new

# Production example (do NOT put real credentials in this file):
# MONGODB_URI=mongodb://cipherq_app:<password>@<host>:27017/ibqc?tls=true&authSource=ibqc
# or, for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://cipherq_app:<password>@<cluster>.mongodb.net/ibqc

# Optional: CA bundle for a self-hosted MongoDB deployment with a
# private/self-signed TLS certificate. Leave unset for Atlas or any
# publicly-trusted certificate.
# MONGODB_TLS_CA_FILE=/etc/cipherq/mongo-ca.pem

# Optional: how long (ms) the backend waits for MongoDB before
# reporting it unavailable instead of hanging. Default 10000.
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# With APP_ENV=production, the backend refuses to start unless
# MONGODB_URI carries credentials/authSource AND requests TLS.
# See docs/SECURITY_MONGODB.md for the full picture, including
# encryption-AT-REST (a separate, server-side concern this .env
# cannot configure).

# --- App environment / auth ------------------------------------------
# APP_ENV=production
# ALLOWED_ORIGINS=https://cipherq-frontend.example.com
# JWT_SECRET=

# Optional. Qira chat has a local read-only responder when these are unset.
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=claude-sonnet-4-6

# --- Local whole-document application encryption --------------------
# This package is intended to run against an already-migrated encrypted
# local database. Keep the key file outside source control.
CIPHERQ_WHOLE_DB_ENCRYPTION=true
CIPHERQ_ENCRYPTION_STRICT=true
CIPHERQ_WHOLE_DB_ENCRYPTION_KEY_FILE=./database/.whole_db_encryption_key
